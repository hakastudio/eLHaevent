{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/maintenance",
      "destination": "/maintenance.html"
    },
    {
      "source": "/maintenance/",
      "destination": "/maintenance.html"
    },
    {
      "source": "/maintenance.html",
      "destination": "/maintenance.html"
    },
    {
      "source": "/adminelha",
      "destination": "/index.html"
    },
    {
      "source": "/adminelha/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
